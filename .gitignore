# Data and databases — NEVER in the repository
data/
media/

# Secrets — anything that looks like a .env stays out, except the template.
# The rule is deliberately broad: .env.backup and .env.save, written by hand
# during past maintenance, slipped past a narrower pattern and hold real
# credentials.
.env*
!.env.example

# The real names of this installation, read by `make test` to keep them out
# of every tracked file. Listing them here would publish them.
.private-names

# Local stacks: services that run on this machine only (experiments, separate
# projects) are declared here rather than in a dedicated branch.
# See docker-compose.override.yml.example.
docker-compose.override.yml

# OS
.DS_Store
Thumbbs.db

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Virtual environments
venv/
.venv/
scripts/venv/
