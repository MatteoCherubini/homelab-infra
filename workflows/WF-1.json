    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.stdout;\nlet data;\n\ntry {\n  data = JSON.parse(raw);\n} catch (e) {\n  data = {\n    fatal: `Impossibile parsare output SSH: ${e.message}`,\n    manifest: [], updates: [], errors: [],\n    unchanged: [], untracked_warnings: [],\n    run_at: new Date().toISOString(),\n    summary: { has_fatal: true }\n  };\n}\n\n// Normalizza: aggiunge has_fatal se lo script l'ha emesso alla radice\nif (data.fatal && !data.summary?.has_fatal) {\n  data.summary = { ...data.summary, has_fatal: true };\n}\n\nreturn [{ json: data }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        -432
      ],
      "id": "acc7c295-7abb-46ab-8d0c-f30e8b7d276d",
      "name": "Parse full output"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst notifications = [];\nconst runTime = data.run_at?.slice(0, 16).replace('T', ' ') + ' UTC' || 'N/A';\n\n// ── 1. FATAL: qualcosa di grave ha impedito il check ─────────────────────────\nif (data.summary?.has_fatal || data.fatal) {\n  notifications.push({\n    title: 'Homelab - Update Checker Failed',   // ← no emoji, no em dash\n    priority: 'urgent',\n    tags: 'rotating_light',\n    body: `🚨 Il check degli aggiornamenti ha fallito completamente.\\n\\n❌ ${data.fatal || 'Errore sconosciuto'}\\n\\n⏱ ${runTime}`\n  });\n  // Se è fatal non ha senso controllare il resto\n  return notifications.map(n => ({ json: n }));\n}\n\n// ── 2. ERRORI RSS ─────────────────────────────────────────────────────────────\nif (data.errors?.length > 0) {\n  const hasCritical = data.errors.some(e => e.criticality === 'critical');\n  const lines = data.errors.map(e =>\n    `• ${e.display_name}  [${e.criticality} · ${e.stack_name}]\\n  ↳ ${e.error_detail}`\n  ).join('\\n\\n');\n\n  notifications.push({\n    title: `Homelab Updates - ${data.errors.length} errore/i RSS`,\n    priority: hasCritical ? 'high' : 'default',\n    tags: 'warning',\n    body: `⚠️ Errori nel controllo aggiornamenti (${runTime}):\\n\\n${lines}`\n  });\n}\n\n// ── 3. AGGIORNAMENTI DISPONIBILI ──────────────────────────────────────────────\nif (data.updates?.length > 0) {\n  const hasMajorOrCritical = data.updates.some(\n    u => u.is_major_bump || u.criticality === 'critical'\n  );\n\n  const lines = data.updates\n    .sort((a, b) => {\n      // Ordinamento: critical prima, poi per bump_type\n      const critOrder = { critical: 0, medium: 1, low: 2, stateless: 3 };\n      const bumpOrder = { major: 0, minor: 1, patch: 2, unknown: 3 };\n      return (critOrder[a.criticality] ?? 9) - (critOrder[b.criticality] ?? 9)\n          || (bumpOrder[a.bump_type] ?? 9) - (bumpOrder[b.bump_type] ?? 9);\n    })\n    .map(u => {\n      const bumpIcon = u.bump_type === 'major' ? '🔴 MAJOR'\n                     : u.bump_type === 'minor' ? '🟡 minor'\n                     : '🟢 patch';\n      const critFlag = u.criticality === 'critical' ? ' ⚡' : '';\n      return `${bumpIcon}  ${u.display_name}${critFlag}\\n  ${u.current_version} → ${u.latest_version}`;\n    })\n    .join('\\n\\n');\n\n  notifications.push({\n    title: `Homelab Updates - ${data.updates.length} aggiornamento/i disponibile/i`,\n    priority: hasMajorOrCritical ? 'high' : 'default',\n    tags: hasMajorOrCritical ? 'arrow_up,exclamation' : 'arrow_up',\n    body: `🔄 Aggiornamenti disponibili (${runTime}):\\n\\n${lines}`\n  });\n}\n\n// ── 4. SERVIZI NON CENSITI ────────────────────────────────────────────────────\nif (data.untracked_warnings?.length > 0) {\n  notifications.push({\n    title: `Homelab - ${data.untracked_warnings.length} servizio/i non censiti`,\n    priority: 'low',\n    tags: 'memo',\n    body: `📋 Servizi Docker non in services_metadata.json:\\n\\n${data.untracked_warnings.map(s => `• ${s}`).join('\\n')}\\n\\nAggiungili al file per abilitare il tracking.`\n  });\n}\n\n// Se non c'è nulla → array vuoto, il nodo HTTP non esegue\nreturn notifications.map(n => ({ json: n }));"
      },
      "type": "n8n-nodes-base.code",
