#!/bin/bash
# =============================================================================
# kg-ups-handler — blackout orchestration on NEXUS (NUT: upssched CMDSCRIPT + upsmon SHUTDOWNCMD).
#
# Strategy, driven by the actual power numbers of this homelab:
#   torre (GPU, up to ~400W)  = the battery hog and the slowest to stop  -> goes down EARLY,
#                               ~60s after the power fails (rides out flickers, no more).
#   nexus (~80W)              = light load -> keeps running on battery for a long time once
#                               torre is off, so it stays up to notify and be the last to go.
#   nexus goes down at LOWBATT, via upsmon's SHUTDOWNCMD (the standard NUT path, which also
#   arms the killpower flag so the UPS cuts output and everything reboots on AC restore).
#
# Why not decide on battery.runtime: this model's runtimecal is calibrated at 4%/8% load, so
# any runtime estimate under real load is fiction. Time-since-ONBATT is honest; runtime is not.
#
# Security: the ntfy token lives in /etc/nut/kg-ups.env (chmod 0600, owned by root).
#   printf 'NTFY_TOKEN=tk_...\n' | sudo tee /etc/nut/kg-ups.env && sudo chmod 0600 /etc/nut/kg-ups.env
#
# Install ON NEXUS: install -m 0755 kg-ups-handler /usr/local/bin/kg-ups-handler
# Called as:  kg-ups-handler <event>     (torre-down | nexus-down | notify-onbatt | notify-online)
# Test (no shutdown):  KG_UPS_DRYRUN=1 kg-ups-handler torre-down
# =============================================================================
set -u

# ── Config (overridable via env) ─────────────────────────────────────────────
TORRE_IP="${TORRE_IP:-10.0.10.10}"
TORRE_SSH_USER="${TORRE_SSH_USER:-root}"
COMPOSE_UNIT="${COMPOSE_UNIT:-homelab-compose.service}"
COMPOSE_DIR="${COMPOSE_DIR:-/opt/homelab-infra}"
DRY="${KG_UPS_DRYRUN:-0}"

# ── ntfy (token from a separate 0600 file — never hardcoded) ─────────────────
NTFY_URL="${NTFY_URL:-http://127.0.0.1:8091/homelab-power}"
NTFY_TOKEN="${NTFY_TOKEN:-}"
[ -r /etc/nut/kg-ups.env ] && . /etc/nut/kg-ups.env

# ── Helpers ──────────────────────────────────────────────────────────────────
log() { logger -t kg-ups "$*" 2>/dev/null || true; echo "kg-ups: $*"; }
run() { if [ "$DRY" = "1" ]; then echo "DRY: $*"; else "$@"; fi; }

notify() {  # $1=title  $2=body  [$3=priority]  [$4=tags]
  local title="$1" body="$2" prio="${3:-default}" tags="${4:-zap}"
  log "NOTIFY: ${title}"
  if [ -z "$NTFY_TOKEN" ]; then
    log "NTFY_TOKEN not set — skipping push (check /etc/nut/kg-ups.env)"
    return 0
  fi
  # Best-effort: never block shutdown on a failed notify. Sends even in dry-run (read-only).
  curl -fsS -m 5 \
    -H "Authorization: Bearer ${NTFY_TOKEN}" \
    -H "Title: ${title}" -H "Priority: ${prio}" -H "Tags: ${tags}" \
    -d "${body}" "${NTFY_URL}" >/dev/null 2>&1 \
    || log "notify failed (expected if internet/ntfy is down)"
}

ssh_torre() {
  run ssh -i /var/lib/nut/.ssh/id_ed25519 \
      -o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
      "${TORRE_SSH_USER}@${TORRE_IP}" "$@"
}

# ── Events ───────────────────────────────────────────────────────────────────
case "${1:-}" in

  torre-down)
    notify "Power cut — shutting torre down" \
           "Mains down for >60s. torre is shutting down now; nexus stays up on battery." \
           "urgent" "electric_plug"
    log "on battery -> emergency shutdown of torre"
    if ssh_torre torre-emergency-shutdown; then
      log "torre shutdown issued"
    else
      log "torre unreachable or already off (nothing to do)"
    fi
    ;;

  nexus-down)
    notify "Battery low — shutting nexus down" \
           "LOWBATT reached. Compose down, then halt. Everything comes back by itself on mains restore." \
           "urgent" "battery"
    log "low battery -> stopping stacks and powering off nexus"
    if systemctl list-unit-files 2>/dev/null | grep -q "^${COMPOSE_UNIT}"; then
      run systemctl stop "$COMPOSE_UNIT" || log "WARN: systemctl stop ${COMPOSE_UNIT} failed"
    else
      ( cd "$COMPOSE_DIR" && run docker compose down --timeout 30 ) || log "WARN: compose down failed"
    fi
    run sync
    log "halting"
    run /sbin/shutdown -h now
    ;;

  notify-onbatt)
    notify "Power cut — running on battery" \
           "Mains down. torre shuts down in ~60s; nexus stays up on battery." \
           "urgent" "electric_plug"
    ;;

  notify-online)
    notify "Mains restored" \
           "Power is back. torre wakes itself on the next ingest (WoL)." \
           "default" "white_check_mark"
    ;;

  *)
    log "unknown event: ${1:-<empty>}"
    exit 1
    ;;
esac
exit 0
