# Excluded from the "work" set — restic exclude patterns, placeholders as in
# work.paths. docs/backup.md

# Live database files: a copy taken while they are written is not usable.
# Their consistent copies are in ${MEDIA_ROOT}/backup/dumps.
${DATA_ROOT}/vaultwarden/data/db.sqlite3*
${DATA_ROOT}/nginx/data/database.sqlite*
${DATA_ROOT}/ntfy/data/auth.db*
${MEDIA_ROOT}/forgejo/data/gitea/gitea.db*

# Live indexes and queues with no consistent copy, rebuilt by the services:
# Syncthing rescans its folders, Forgejo rebuilds its search index at start.
# Syncthing's configuration and device identity, beside the index, are kept.
${DATA_ROOT}/syncthing/config/index-v2
${MEDIA_ROOT}/forgejo/data/gitea/queues
${MEDIA_ROOT}/forgejo/data/gitea/indexers

# Worthless after a restore: login sessions (everyone signs in again),
# temporary files, repository archives generated on download, logs. The
# access logs would also keep IP addresses for as long as the history lasts.
${MEDIA_ROOT}/forgejo/data/gitea/sessions
${MEDIA_ROOT}/forgejo/data/gitea/tmp
${MEDIA_ROOT}/forgejo/data/gitea/repo-archive
${MEDIA_ROOT}/forgejo/data/gitea/log
${DATA_ROOT}/nginx/data/logs

# Regenerated by the services themselves
${DATA_ROOT}/n8n/data/binaryData
${DATA_ROOT}/vaultwarden/data/icon_cache
