# ╔══════════════════════════════════════════════════════════════╗
# ║                  HOMELAB – CONFIGURATION                    ║
# ║  Copy this file to .env and fill in your own values         ║
# ║  Generate passwords with: openssl rand -base64 24           ║
# ║  The configuration model is explained in docs/configuration.md ║
# ╚══════════════════════════════════════════════════════════════╝

# ── DATA PATHS ────────────────────────────────────────────────
DATA_ROOT=/opt/homelab-infra/data
MEDIA_ROOT=/mnt/raid/homelab-media

# ── SYSTEM ────────────────────────────────────────────────────
TZ=Europe/Rome
PUID=1000
PGID=1000
HOMELAB_SUBNET=172.20.0.0/16

# ── PORTS ─────────────────────────────────────────────────────
# Core
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_ADMIN_PORT=81
HOMEPAGE_PORT=3000
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# AI
OLLAMA_PORT=11434

# Automation
N8N_PORT=5678

# Syncthing (Knowledge Genome raw ingress — works in tandem with n8n)
# GUI/API published only on the host's 127.0.0.1; n8n reaches it via the Docker network.
SYNCTHING_GUI_PORT=8384
SYNCTHING_SYNC_PORT=22000
SYNCTHING_DISCOVERY_PORT=21027
SYNCTHING_URL=http://homelab-infra-syncthing-1:8384
SYNCTHING_API_KEY=CHANGE_ME
# Genome working tree (checkout + private staging area) mounted into Syncthing.
# Identical host↔container path (shared with the SSH-based commit job on the server).
GENOME_VAULTS_ROOT=/srv/genome-vaults

# ── Knowledge Genome — read by the n8n flows as $env ────────────
# These reach BOTH n8n and n8n-worker through the x-kg-env anchor; in queue
# mode a value that reaches only one resolves to an empty string at run time.
# Detail: docs/configuration.md and docs/stacks/automation.md
#
# SSH aliases resolved in n8n-runner's ~/.ssh/config ON THIS HOST — not DNS names
# n8n resolves itself: the path is two hops, n8n → n8n-runner on the server → ssh.
KG_AI_HOST=ai-node
KG_HYPERVISOR_HOST=hypervisor
# The AI node's guest id on the hypervisor (a Proxmox VMID).
KG_AI_VMID=CHANGE_ME
# Unix account owning the genome vaults, reached with sudo -u by the raw watcher.
KG_SERVICE_USER=CHANGE_ME
# CONTAINER ADDRESS, not the public hostname: `forgejo` is already in
# N8N_SSRF_ALLOWED_HOSTNAMES and the public hostname is not — and this way the
# call never leaves the machine, so it keeps working with the tunnel down.
# The port is the INTERNAL one (3000), not FORGEJO_HTTP_PORT which is published.
FORGEJO_URL=http://forgejo:3000
# THE ADDRESS A PERSON REACHES, and it must NOT equal FORGEJO_URL above:
# every link meant to be tapped by hand is built from this one.
FORGEJO_WEB_BASE=CHANGE_ME
KG_NTFY_URL=http://ntfy
KG_NTFY_TOPIC=knowledge-genome
KG_IDLE_MINUTES=30
# AUTHORISATION list: the forge accounts whose merge may start a phase.
# EMPTY MEANS EVERY SENDER IS REFUSED — it fails closed on purpose, because an
# automation that runs for anyone is worse than one that runs for no one.
KG_ALLOWED_SENDERS=CHANGE_ME

# Wake-on-LAN target for the hypervisor (format AA:BB:CC:DD:EE:FF)
KG_HYPERVISOR_MAC=CHANGE_ME

# Git
FORGEJO_HTTP_PORT=3001
FORGEJO_SSH_PORT=222

# Tools
EXCALIDRAW_PORT=8092

# Ntfy
NTFY_PORT=8091

# Vaultwarden
VAULTWARDEN_PORT=8096

# UPS: NUT runs on the host, not in Compose — see docs/stacks/ups.md

# ── BACKUP (restic, off-site) — docs/backup.md ────────────────
# One repository per backup set (backup/<set>.paths). Hetzner Object Storage:
#   s3:https://<location>.your-objectstorage.com/<bucket>/<set>
BACKUP_WORK_REPOSITORY=s3:https://fsn1.your-objectstorage.com/CHANGE_ME/work
BACKUP_ARCHIVE_REPOSITORY=s3:https://fsn1.your-objectstorage.com/CHANGE_ME/archive
BACKUP_S3_REGION=fsn1
# History, applied only by `make backup-maintenance`: the nightly key cannot
# delete, so nothing ages out on its own. Per set, BACKUP_<SET>_KEEP_*, else
# these. Short on purpose: about three months, enough to undo a mistake, short
# enough for a client's data to really leave the backups after an exit.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=3
BACKUP_KEEP_YEARLY=0
# The archive outlives everything else: contracts and invoices, ten years.
BACKUP_ARCHIVE_KEEP_DAILY=7
BACKUP_ARCHIVE_KEEP_WEEKLY=5
BACKUP_ARCHIVE_KEEP_MONTHLY=12
BACKUP_ARCHIVE_KEEP_YEARLY=10
# `make healthcheck` fails when the last fully successful run is older.
BACKUP_MAX_AGE_HOURS=26
# …and when another machine's newest configuration copy is older (days).
# docs/backup.md, "Other machines"
HOST_CONFIG_MAX_AGE_DAYS=100

# ══════════════════════════════════════════════════════════════
# SECRETS — GENERATE AND REPLACE EVERY VALUE BELOW
# Command: openssl rand -base64 24
# ══════════════════════════════════════════════════════════════

# n8n (v2 — needs an encryption key and a runner token)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_WITH_openssl_rand_hex_32

# Lets nodes read environment variables. Must stay false: the workflows take
# their configuration from {{ $env.X }}. Both n8n and n8n-worker now read this
# key; until 0.5.3 the compose file had `false` written into it, so changing
# this line had no effect at all.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# n8n Security
N8N_SSRF_PROTECTION_ENABLED=true
# `default` is a keyword, not a literal list: it expands to n8n's built-in set
# (loopback, RFC 1918, link-local, IPv6 ULA, reserved ranges). Keep it rather
# than spelling the ranges out, or the block list silently stops tracking
# upstream. n8n 3.0 adds the CGNAT space 100.64.0.0/10 and the IPv6 transition
# ranges to that set, which is where Tailscale lives — harmless here, because
# nothing n8n requests over HTTP has a Tailscale address: internal calls go by
# container name, and the SSH hops are not n8n requests. Should that change,
# allowlist the host below instead of editing this line.
N8N_SSRF_BLOCKED_IP_RANGES=default,169.254.169.254/32
# NB: 'syncthing' added to the allowlist so that n8n HTTP Requests to
# http://syncthing:8384 (permissions control plane + raw commits) are not blocked.
N8N_SSRF_ALLOWED_HOSTNAMES=forgejo,forgejo.homelab,npm.homelab,ntfy.homelab,ntfy,syncthing,ollama
N8N_ENCRYPTION_KEY=<generate with: openssl rand -hex 32>

# n8n Webhook
N8N_WEBHOOK_HMAC_SECRET=<generate with: openssl rand -hex 32>
N8N_WEBHOOK_URL=https://n8n.example.com

# n8n runtime limits, pinned to the values that are the default today, because
# n8n 3.0 shrinks all three. stacks/automation/compose.yml passes them to both
# n8n and n8n-worker; listing them here alone, as they were, configured nothing.
#
# OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS used to sit here. It never reached the
# container either, and n8n 3.0 removes it outright: in queue mode manual
# executions always run on workers. Adopting that early moves real load off the
# main instance, so it belongs to the 3.0 upgrade, not to tidying the template.
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000

# Vaultwarden
# Leaving this COMMENTED OUT keeps the admin panel disabled, which is the
# intended steady state. To enable it temporarily: uncomment it with an Argon2
# hash produced by `vaultwarden hash` (never plaintext), recreate the
# container, and comment it out again afterwards.
# VAULTWARDEN_ADMIN_TOKEN=<Argon2 hash from `vaultwarden hash`>
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=true

VAULTWARDEN_SMTP_HOST=smtp.gmail.com
VAULTWARDEN_SMTP_PORT=587
VAULTWARDEN_SMTP_SECURITY=starttls
VAULTWARDEN_SMTP_USER=you@example.com        # the account used to authenticate
VAULTWARDEN_SMTP_PASS=xxxx-xxxx-xxxx-xxxx    # provider app password
VAULTWARDEN_SMTP_FROM=you+vaultwarden@example.com  # plus-addressed sender

# Backup — the NIGHTLY key: it writes and reads, and may delete only restic's
# lock files (bucket policy in docs/backup.md). The admin key that can prune
# is never stored here: `make backup-maintenance` asks for it.
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
# One password per repository: lose one and that backup is unreadable. Keep
# them in Vaultwarden AND on the paper recovery sheet — Vaultwarden is backed
# up by this very repository.
BACKUP_WORK_PASSWORD=CHANGE_ME_WITH_openssl_rand_hex_32
BACKUP_ARCHIVE_PASSWORD=CHANGE_ME_WITH_openssl_rand_hex_32

# ══════════════════════════════════════════════════════════════
# DOMAINS / TRUSTED HOSTS
# ══════════════════════════════════════════════════════════════
# Decide both BEFORE the first start; neither is safely changeable later.
# FORGEJO_DOMAIN     changing it breaks existing git remotes and webhook URLs.
# VAULTWARDEN_DOMAIN WebAuthn binds passkeys to this exact value.
# Detail: docs/configuration.md
FORGEJO_DOMAIN=git.example.com
VAULTWARDEN_DOMAIN=vault.example.com

HOMEPAGE_ALLOWED_HOSTS=*

# ╔══════════════════════════════════════════════════════════════╗
# ║                  HOMELAB VERSIONS SSoT                       ║
# ╚══════════════════════════════════════════════════════════════╝
# BACKUP_TOOLS and RESTIC run through `docker run`, not Compose, so the
# release checker does not see them: review them at the quarterly session.
BACKUP_TOOLS_VERSION=3.24
CLOUDFLARED_VERSION=latest
EXCALIDRAW_VERSION=latest
FORGEJO_VERSION=15.0.9
HOMEPAGE_VERSION=v1.13.2
N8N_VERSION=2.41.6
N8N_DB_VERSION=18-alpine
N8N_REDIS_VERSION=8-alpine
NGINX_VERSION=2.16.0
OLLAMA_VERSION=latest
NTFY_VERSION=v2.28.0
RESTIC_VERSION=0.19.1
SYNCTHING_VERSION=2.1.5
VAULTWARDEN_VERSION=1.37.3

# ╔══════════════════════════════════════════════════════════════╗
# ║                  HOMELAB REPOSITORIES SSoT                   ║
# ╚══════════════════════════════════════════════════════════════╝
BACKUP_TOOLS_IMAGE=alpine
CLOUDFLARED_IMAGE=cloudflare/cloudflared
EXCALIDRAW_IMAGE=excalidraw/excalidraw
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage
N8N_DB_IMAGE=postgres
N8N_IMAGE=n8nio/n8n
N8N_REDIS_IMAGE=redis
NGINX_IMAGE=jc21/nginx-proxy-manager
OLLAMA_IMAGE=ollama/ollama
NTFY_IMAGE=binwiederhier/ntfy
RESTIC_IMAGE=restic/restic
SYNCTHING_IMAGE=syncthing/syncthing
VAULTWARDEN_IMAGE=vaultwarden/server
