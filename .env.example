# ╔══════════════════════════════════════════════════════════════╗
# ║                 HOMELAB – CONFIGURAZIONE                    ║
# ║  Copia questo file in .env e personalizza i valori          ║
# ║  Genera password con: openssl rand -base64 24               ║
# ╚══════════════════════════════════════════════════════════════╝

# ── PATH DATI ─────────────────────────────────────────────────
DATA_ROOT=/opt/homelab-infra/data
MEDIA_ROOT=/mnt/md0/homelab_data

# ── SISTEMA ───────────────────────────────────────────────────
TZ=Europe/Rome
PUID=1000
PGID=1000
HOMELAB_SUBNET=172.20.0.0/16

# ── PORTE ─────────────────────────────────────────────────────
# Core
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_ADMIN_PORT=81
HEADSCALE_PORT=8085
HEADSCALE_UI_PORT=8086
PORTAINER_PORT=9000
HOMEPAGE_PORT=3000
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# Cloud
NEXTCLOUD_PORT=8088

# Photos
IMMICH_PORT=2283

# Docs
PAPERLESS_PORT=8089

# AI
OLLAMA_PORT=11434
OPENWEBUI_PORT=8090

# Automation
N8N_PORT=5678

# Git
FORGEJO_HTTP_PORT=3001
FORGEJO_SSH_PORT=222

# Security
VAULTWARDEN_PORT=8087

# Storage
GARAGE_API_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
KOPIA_PORT=51515

# Monitoring
NETDATA_PORT=19999
GRAFANA_PORT=3003

# Tools
NTFY_PORT=8091
EXCALIDRAW_PORT=8092

# UPS (abilitare dopo setup fisico)
# NUT_PORT=3493

# ══════════════════════════════════════════════════════════════
# PASSWORD — GENERA E CAMBIA TUTTI QUESTI VALORI!
# Comando: openssl rand -base64 24
# Salva una copia in Vaultwarden + backup offline
# ══════════════════════════════════════════════════════════════

# Nextcloud
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=CHANGE_ME

# Paperless
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=CHANGE_ME
PAPERLESS_SECRET_KEY=CHANGE_ME_WITH_openssl_rand_hex_32
PAPERLESS_OCR_LANGUAGE=ita+eng

# n8n (v2 — richiede encryption key e runner token)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_WITH_openssl_rand_hex_32

# n8n Security
N8N_SSRF_PROTECTION_ENABLED=true
N8N_SSRF_BLOCKED_IP_RANGES=default,169.254.169.254/32
N8N_SSRF_ALLOWED_HOSTNAMES=forgejo.homelab,npm.homelab,ntfy.homelab,nextcloud.homelab
N8N_ENCRYPTION_KEY=<generare con: openssl rand -hex 32>

# n8n Webhook
N8N_WEBHOOK_HMAC_SECRET=<generare con: openssl rand -hex 32>
# Usare questo valore nei workflow come segreto condiviso per la firma HMAC

# Immich
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=CHANGE_ME

# Open WebUI
OPENWEBUI_SECRET_KEY=CHANGE_ME_WITH_openssl_rand_hex_32

# Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ══════════════════════════════════════════════════════════════
# DOMINI / TRUSTED HOSTS
# ══════════════════════════════════════════════════════════════
NEXTCLOUD_TRUSTED_DOMAINS=10.0.10.20 localhost
HOMEPAGE_ALLOWED_HOSTS=*

# ══════════════════════════════════════════════════════════════
# VAULTWARDEN
# ══════════════════════════════════════════════════════════════
VAULTWARDEN_SIGNUPS_ALLOWED=true
# Metti false DOPO aver creato il tuo account

# ══════════════════════════════════════════════════════════════
# OLLAMA/IMMICH – GPU (nvidia gtx 1660 super / none)
# ══════════════════════════════════════════════════════════════
# Metti "true" se hai una GPU NVIDIA con nvidia-container-toolkit
OLLAMA_GPU_ENABLED=false

# Machine Learning Tuning per 1660 Super (6GB VRAM)
# Manteniamo 1 worker per lasciare VRAM libera per il transcoding video fluido
#MACHINE_LEARNING_WORKERS=1

# ╔══════════════════════════════════════════════════════════════╗
# ║                  HOMELAB VERSIONS SSoT                       ║
# ╚══════════════════════════════════════════════════════════════╝
CLOUDFLARED_VERSION=latest
EXCALIDRAW_VERSION=latest
FORGEJO_VERSION=10
GARAGE_VERSION=v1.0.1
GRAFANA_VERSION=11.5.2
HEADSCALE_VERSION=0.25
HEADSCALE_UI_VERSION=2025.01.20
HOMEPAGE_VERSION=v0.10.9
IMMICH_DB_VERSION=16-vectorchord0.5.3-pgvector0.8.1
IMMICH_MACHINE_LEARNING_VERSION=v2.7.5-cuda
IMMICH_REDIS_VERSION=9-alpine
IMMICH_SERVER_VERSION=v2.7.5
KOPIA_VERSION=0.19
LOKI_VERSION=3.4.2
N8N_VERSION=2.15.0
N8N_DB_VERSION=18-alpine
N8N_REDIS_VERSION=8-alpine
N8N_WORKER_VERSION=2.15.0
NETDATA_VERSION=v2.3.0
NEXTCLOUD_VERSION=33.0.2-apache
NEXTCLOUD_DB_VERSION=16-alpine
NEXTCLOUD_REDIS_VERSION=7-alpine
NGINX_VERSION=2.14.0
NTFY_VERSION=v2.11.0
OLLAMA_VERSION=0.21.0
OLLAMA_GPU_VERSION=0.21.0
OPEN_WEBUI_VERSION=v0.8.12
PAPERLESS_VERSION=2.20.13
PAPERLESS_DB_VERSION=16-alpine
PAPERLESS_REDIS_VERSION=7-alpine
PORTAINER_VERSION=2.25.1
PROMTAIL_VERSION=3.4.2
VAULTWARDEN_VERSION=1.33.2

# ╔══════════════════════════════════════════════════════════════╗
