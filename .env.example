# ╔══════════════════════════════════════════════════════════════╗
# ║                 HOMELAB – CONFIGURAZIONE                    ║
# ║  Copia questo file in .env e personalizza i valori          ║
# ║  Genera password con: openssl rand -base64 24               ║
# ╚══════════════════════════════════════════════════════════════╝

# ── PATH DATI ─────────────────────────────────────────────────
DATA_ROOT=/opt/homelab-infra/data
MEDIA_ROOT=/mnt/md0/homelab_data

# ── SISTEMA ───────────────────────────────────────────────────
TZ=Europe/Rome
PUID=1000
PGID=1000
HOMELAB_SUBNET=172.20.0.0/16

# ── PORTE ─────────────────────────────────────────────────────
# Core
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_ADMIN_PORT=81
HOMEPAGE_PORT=3000
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# AI
OLLAMA_PORT=11434

# Automation
N8N_PORT=5678

# Syncthing (Knowledge Genome raw ingress — works in tandem with n8n)
# GUI/API published only on the host's 127.0.0.1; n8n reaches it via the Docker network.
SYNCTHING_GUI_PORT=8384
SYNCTHING_SYNC_PORT=22000
SYNCTHING_DISCOVERY_PORT=21027
SYNCTHING_URL=http://homelab-infra-syncthing-1:8384
SYNCTHING_API_KEY=CHANGE_ME
# Genome working tree (checkout + private staging area) mounted into Syncthing.
# Identical host↔container path (shared with the SSH-based commit job on nexus).
GENOME_VAULTS_ROOT=/srv/genome-vaults

# ── Knowledge Genome — read by the n8n flows as $env ────────────
#
# These go on n8n AND on n8n-worker. In queue mode the nodes execute in the
# worker, and it is the executing process that resolves {{ $env.X }} — a value
# set only on n8n gives a flow that looks configured in the editor and resolves
# to an empty string at run time. The x-kg-env anchor in
# stacks/automation/compose.yml makes that state unrepresentable; this file
# supplies the values.
#
# SSH aliases resolved in n8n-runner's ~/.ssh/config ON THIS HOST — not DNS names
# n8n resolves itself: the path is two hops, n8n → n8n-runner@nexus → ssh.
KG_AI_HOST=ai-node
KG_AI_VMID=ai-node-id
KG_HYPERVISOR_HOST=hypervisor
# Unix account owning the genome vaults, reached with sudo -u by the raw watcher.
KG_SERVICE_USER=CHANGE_ME
# CONTAINER ADDRESS, not the public hostname: `forgejo` is already in
# N8N_SSRF_ALLOWED_HOSTNAMES and the public hostname is not — and this way the
# call never leaves the machine, so it keeps working with the tunnel down.
# The port is the INTERNAL one (3000), not FORGEJO_HTTP_PORT which is published.
FORGEJO_URL=http://forgejo:3000
# THE ADDRESS A PERSON REACHES, and it must NOT equal FORGEJO_URL.
# FORGEJO_URL above is the container hop; a notification's tap target built from
# it opens nothing anywhere a phone is. Every link meant to be clicked by hand
# comes from this one. Unset, the flows emit no link and say so in the message
# body — a tap that fails is worse than a line naming the key.
FORGEJO_WEB_BASE=CHANGE_ME
KG_NTFY_URL=http://ntfy
KG_NTFY_TOPIC=knowledge-genome
KG_IDLE_MINUTES=30
# AUTHORISATION list: the forge accounts whose merge may start a phase.
# EMPTY MEANS EVERY SENDER IS REFUSED — it fails closed on purpose, because an
# automation that runs for anyone is worse than one that runs for no one.
KG_ALLOWED_SENDERS=CHANGE_ME

# Torre WoL (TORRE_MAC=AA:BB:CC:DD:EE:FF)
TORRE_MAC=CHANGE_ME

# Git
FORGEJO_HTTP_PORT=3001
FORGEJO_SSH_PORT=222

# Tools
EXCALIDRAW_PORT=8092

# Ntfy
NTFY_PORT=8091

# Vaultwarden
VAULTWARDEN_PORT=8096

# UPS (abilitare dopo setup fisico — futuro, gestito via n8n)
# NUT_PORT=3493

# ══════════════════════════════════════════════════════════════
# PASSWORD — GENERA E CAMBIA TUTTI QUESTI VALORI!
# Comando: openssl rand -base64 24
# ══════════════════════════════════════════════════════════════

# n8n (v2 — richiede encryption key e runner token)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_WITH_openssl_rand_hex_32

# n8n env access dai nodi
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# n8n Security
N8N_SSRF_PROTECTION_ENABLED=true
N8N_SSRF_BLOCKED_IP_RANGES=default,169.254.169.254/32
# NB: 'syncthing' added to the allowlist so that n8n HTTP Requests to
# http://syncthing:8384 (permissions control plane + raw commits) are not blocked.
N8N_SSRF_ALLOWED_HOSTNAMES=forgejo,forgejo.homelab,npm.homelab,ntfy.homelab,ntfy,syncthing,ollama
N8N_ENCRYPTION_KEY=<generare con: openssl rand -hex 32>

# n8n Webhook
N8N_WEBHOOK_HMAC_SECRET=<generare con: openssl rand -hex 32>
N8N_WEBHOOK_URL=https://n8n.keruhomelab.com

# n8n Scaling / Runners (deprecation warnings da 2.33+)
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000

# Vaultwarden
VAULTWARDEN_ADMIN_TOKEN=<generare con: openssl rand -base64 48>
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=true

VAULTWARDEN_SMTP_HOST=smtp.gmail.com
VAULTWARDEN_SMTP_PORT=587
VAULTWARDEN_SMTP_SECURITY=starttls
VAULTWARDEN_SMTP_USER=tuo@gmail.com          # account reale per autenticarsi
VAULTWARDEN_SMTP_PASS=xxxx-xxxx-xxxx-xxxx    # App Password Gmail
VAULTWARDEN_SMTP_FROM=tuo+vaultwarden@gmail.com  # alias + per il mittente

# ══════════════════════════════════════════════════════════════
# DOMINI / TRUSTED HOSTS
# ══════════════════════════════════════════════════════════════
HOMEPAGE_ALLOWED_HOSTS=*

# ╔══════════════════════════════════════════════════════════════╗
# ║                  HOMELAB VERSIONS SSoT                       ║
# ╚══════════════════════════════════════════════════════════════╝
CLOUDFLARED_VERSION=latest
EXCALIDRAW_VERSION=latest
FORGEJO_VERSION=15.0.9
HOMEPAGE_VERSION=v1.13.2
N8N_VERSION=2.39.10
N8N_DB_VERSION=18-alpine
N8N_REDIS_VERSION=8-alpine
NGINX_VERSION=2.15.1
OLLAMA_VERSION=latest
NTFY_VERSION=v2.28.0
SYNCTHING_VERSION=2.1.5
VAULTWARDEN_VERSION=1.37.3

# ╔══════════════════════════════════════════════════════════════╗
# ║                  HOMELAB REPOSITORIES SSoT                   ║
# ╚══════════════════════════════════════════════════════════════╝
CLOUDFLARED_IMAGE=cloudflare/cloudflared
EXCALIDRAW_IMAGE=excalidraw/excalidraw
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage
N8N_DB_IMAGE=postgres
N8N_IMAGE=n8nio/n8n
N8N_REDIS_IMAGE=redis
NGINX_IMAGE=jc21/nginx-proxy-manager
OLLAMA_IMAGE=ollama/ollama
NTFY_IMAGE=binwiederhier/ntfy
SYNCTHING_IMAGE=syncthing/syncthing
VAULTWARDEN_IMAGE=vaultwarden/server
