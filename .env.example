# ╔══════════════════════════════════════════════════════════════╗
# ║                 HOMELAB – CONFIGURAZIONE                    ║
# ║  Copia questo file in .env e personalizza i valori          ║
# ╚══════════════════════════════════════════════════════════════╝

# ── PATH DATI ─────────────────────────────────────────────────
# DATA_ROOT: dove risiedono config e db (SSD consigliato)
# MEDIA_ROOT: dove risiedono file grandi/media (RAID/HDD)
DATA_ROOT=./data
MEDIA_ROOT=./media

# ── TIMEZONE ──────────────────────────────────────────────────
TZ=Europe/Rome

# ── UID/GID (utente host) ────────────────────────────────────
PUID=1000
PGID=1000

# ── NETWORK ───────────────────────────────────────────────────
# Subnet della rete bridge condivisa
HOMELAB_SUBNET=172.20.0.0/16

# ══════════════════════════════════════════════════════════════
# PORTE ESPOSTE – Modifica se hai conflitti
# ══════════════════════════════════════════════════════════════

# Core
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_ADMIN_PORT=81
HEADSCALE_PORT=8085
HEADSCALE_UI_PORT=8086
PORTAINER_PORT=9000
HOMEPAGE_PORT=3000

# Cloud
NEXTCLOUD_PORT=8088

# Photos
IMMICH_PORT=2283

# Docs
PAPERLESS_PORT=8089

# AI
OLLAMA_PORT=11434
OPENWEBUI_PORT=8090

# Automation
N8N_PORT=5678

# Git
FORGEJO_HTTP_PORT=3001
FORGEJO_SSH_PORT=222

# Security
VAULTWARDEN_PORT=8087

# Storage
GARAGE_API_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
KOPIA_PORT=51515
PINGVIN_PORT=3002

# Monitoring
NETDATA_PORT=19999
GRAFANA_PORT=3003
LOKI_PORT=3100
PROMTAIL_PORT=9080

# Tools
NTFY_PORT=8091
EXCALIDRAW_PORT=8092

# ══════════════════════════════════════════════════════════════
# PASSWORD DATABASE – CAMBIA QUESTI VALORI!
# ══════════════════════════════════════════════════════════════

# Nextcloud
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_nextcloud

# Paperless
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=CHANGE_ME_paperless
PAPERLESS_SECRET_KEY=CHANGE_ME_paperless_secret_key
PAPERLESS_OCR_LANGUAGE=ita+eng

# n8n
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_admin

# Immich
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=CHANGE_ME_immich

# ══════════════════════════════════════════════════════════════
# DOMINI / TRUSTED HOSTS
# ══════════════════════════════════════════════════════════════
NEXTCLOUD_TRUSTED_DOMAINS=localhost
HOMEPAGE_ALLOWED_HOSTS=*

# ══════════════════════════════════════════════════════════════
# VAULTWARDEN
# ══════════════════════════════════════════════════════════════
VAULTWARDEN_SIGNUPS_ALLOWED=false

# ══════════════════════════════════════════════════════════════
# OLLAMA – GPU (nvidia / none)
# ══════════════════════════════════════════════════════════════
# Metti "true" se hai una GPU NVIDIA con nvidia-container-toolkit
OLLAMA_GPU_ENABLED=false
