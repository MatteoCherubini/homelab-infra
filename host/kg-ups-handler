#!/bin/bash
# =============================================================================
# kg-ups-handler — blackout orchestration on the SERVER (NUT: upssched CMDSCRIPT + upsmon SHUTDOWNCMD).
#
# Strategy, driven by the actual power numbers of this homelab:
#   hypervisor (GPU, up to ~400W) = the battery hog and the slowest to stop -> goes down EARLY,
#                                   once the grace period set in upssched.conf has passed.
#   server (~80W)                 = light load -> keeps running on battery for a long time once
#                                   the hypervisor is off, so it stays up to notify and be the last to go.
#   The server goes down at LOWBATT, via upsmon's SHUTDOWNCMD (the standard NUT path, which also
#   arms the killpower flag so the UPS cuts output and everything reboots on AC restore).
#
# Why not decide on battery.runtime: this model's runtimecal is calibrated at 4%/8% load, so
# any runtime estimate under real load is fiction. Time-since-ONBATT is honest; runtime is not.
#
# Configuration lives in /etc/nut/kg-ups.env (root:nut, mode 0640: upssched runs this as nut),
# never in this file:
#   KG_UPS_HYPERVISOR=<ssh destination>   user@address, or an alias in nut's ~/.ssh/config
#   NTFY_TOKEN=tk_...
# On the hypervisor, nut's key carries a forced command (n8n-qm-wrap) that accepts
# `hypervisor-emergency-shutdown [--dry-run]`.
#
# Install ON THE SERVER: install -m 0755 host/kg-ups-handler /usr/local/bin/kg-ups-handler
# Full runbook: docs/stacks/ups.md
# Called as:  kg-ups-handler <event>
#   hypervisor-down | server-down | notify-onbatt | notify-online
#   notify-commbad | notify-commok | notify-nocomm   (the server cannot read the UPS)
# Test (no shutdown):  KG_UPS_DRYRUN=1 kg-ups-handler hypervisor-down
# =============================================================================
set -u

# ── Config ───────────────────────────────────────────────────────────────────
COMPOSE_UNIT="${COMPOSE_UNIT:-homelab-compose.service}"
COMPOSE_DIR="${COMPOSE_DIR:-/opt/homelab-infra}"
DRY="${KG_UPS_DRYRUN:-0}"
NTFY_URL="${NTFY_URL:-http://127.0.0.1:8091/homelab-power}"
NTFY_TOKEN="${NTFY_TOKEN:-}"
KG_UPS_HYPERVISOR="${KG_UPS_HYPERVISOR:-}"
[ -r /etc/nut/kg-ups.env ] && . /etc/nut/kg-ups.env

# ── Helpers ──────────────────────────────────────────────────────────────────
log() { logger -t kg-ups "$*" 2>/dev/null || true; echo "kg-ups: $*"; }
run() { if [ "$DRY" = "1" ]; then echo "DRY: $*"; else "$@"; fi; }

notify() {  # $1=title  $2=body  [$3=priority]  [$4=tags]
  local title="$1" body="$2" prio="${3:-default}" tags="${4:-zap}"
  log "NOTIFY: ${title}"
  if [ -z "$NTFY_TOKEN" ]; then
    log "NTFY_TOKEN not set — skipping push (check /etc/nut/kg-ups.env)"
    return 0
  fi
  # Best-effort: never block shutdown on a failed notify. Sends even in dry-run (read-only).
  curl -fsS -m 5 \
    -H "Authorization: Bearer ${NTFY_TOKEN}" \
    -H "Title: ${title}" -H "Priority: ${prio}" -H "Tags: ${tags}" \
    -d "${body}" "${NTFY_URL}" >/dev/null 2>&1 \
    || log "notify failed (expected if internet/ntfy is down)"
}

# In a dry run the shutdown is still asked for, with --dry-run, so the test
# goes through the forced command for real: a wrapper that stopped accepting
# the verb fails the test instead of passing it.
ssh_hypervisor() {
  local verb=$1
  [ "$DRY" = "1" ] && verb="$verb --dry-run"
  ssh -i /var/lib/nut/.ssh/id_ed25519 \
      -o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
      "$KG_UPS_HYPERVISOR" "$verb"
}

# ── Events ───────────────────────────────────────────────────────────────────
case "${1:-}" in

  hypervisor-down)
    notify "Power cut — shutting the hypervisor down" \
           "Mains down past the grace period. The hypervisor is shutting down now; the server stays up on battery." \
           "urgent" "electric_plug"
    if [ -z "$KG_UPS_HYPERVISOR" ]; then
      notify "UPS: hypervisor not configured" \
             "KG_UPS_HYPERVISOR is empty in /etc/nut/kg-ups.env: the hypervisor was NOT shut down." \
             "urgent" "warning"
      exit 1
    fi
    log "on battery -> emergency shutdown of the hypervisor (${KG_UPS_HYPERVISOR})"
    if ssh_hypervisor hypervisor-emergency-shutdown; then
      log "hypervisor shutdown issued"
    else
      log "hypervisor unreachable, already off, or the verb was refused"
    fi
    ;;

  server-down)
    notify "Battery low — shutting the server down" \
           "LOWBATT reached. Compose down, then halt. Everything comes back by itself on mains restore." \
           "urgent" "battery"
    log "low battery -> stopping stacks and powering off the server"
    if systemctl list-unit-files 2>/dev/null | grep -q "^${COMPOSE_UNIT}"; then
      run systemctl stop "$COMPOSE_UNIT" || log "WARN: systemctl stop ${COMPOSE_UNIT} failed"
    else
      ( cd "$COMPOSE_DIR" && run docker compose down --timeout 30 ) || log "WARN: compose down failed"
    fi
    run sync
    log "halting"
    run /sbin/shutdown -h now
    ;;

  notify-onbatt)
    notify "Power cut — running on battery" \
           "Mains down. The hypervisor shuts down if it lasts past the grace period; the server stays up on battery." \
           "urgent" "electric_plug"
    ;;

  notify-online)
    notify "Mains restored" \
           "Power is back. The hypervisor wakes itself on the next ingest (WoL)." \
           "default" "white_check_mark"
    ;;

  # A UPS the server cannot read is a UPS that protects nothing, and nothing
  # else says so: the driver retries forever and upsmon writes to the journal.
  notify-commbad)
    notify "UPS link lost — power is not watched" \
           "The server has not read the UPS for a minute. Until it does again, a power cut goes unnoticed: the hypervisor is not shut down and the server stops when the battery does. Check the USB cable first." \
           "high" "warning"
    ;;

  notify-commok)
    notify "UPS link back" \
           "The server reads the UPS again: power is watched." \
           "default" "white_check_mark"
    ;;

  notify-nocomm)
    notify "UPS still not readable" \
           "The server cannot read the UPS, and repeats this until it can. A power cut goes unnoticed in the meantime. Check the USB cable (lsusb), then the driver's journal." \
           "high" "warning"
    ;;

  *)
    log "unknown event: ${1:-<empty>}"
    exit 1
    ;;
esac
exit 0
